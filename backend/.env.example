# Copy this file to backend/.env and adjust as needed. Never commit the real .env file.
# All variables are prefixed RECONLEDGER_ and are optional - sensible defaults are used
# when a variable is absent (see backend/app/config.py).

# Network binding. Defaults to loopback-only; changing this requires the explicit
# acknowledgement below (PRD 8.3).
RECONLEDGER_BIND_HOST=127.0.0.1
RECONLEDGER_BIND_PORT=8000
# RECONLEDGER_ACKNOWLEDGE_INSECURE_BIND=true

RECONLEDGER_LOG_LEVEL=INFO

# Provider-facing identification (PRD FR-03 / 9 Provider etiquette).
RECONLEDGER_APP_NAME=ReconLedger
RECONLEDGER_REPOSITORY_URL=https://github.com/AdrielU2605/ReconLedger

# Local SQLite database. The default is a file next to wherever the API is
# started from; migrations are applied with `alembic upgrade head`, never
# automatically at startup (PRD 7.5).
RECONLEDGER_DATABASE_URL=sqlite+aiosqlite:///./reconledger.db

# 9 Process model: exactly one worker process may claim queued jobs. Leave
# this alone unless an external worker coordinator is genuinely managing
# exclusivity for you.
RECONLEDGER_WORKER_LOCK_PATH=reconledger.worker.lock
# RECONLEDGER_EXTERNAL_WORKER_CONFIGURED=true

# FR-01 / 9 Concurrency: one job at a time, up to five collectors per job,
# configurable without code changes.
RECONLEDGER_MAX_CONCURRENT_JOBS=1
RECONLEDGER_MAX_CONCURRENT_COLLECTORS_PER_JOB=5

# FR-12: default retention window for jobs/findings, in days.
RECONLEDGER_RETENTION_DAYS=90

# PRD 4.4: leave this off unless you are intentionally assessing a private/
# reserved IP address of your own during local development.
# RECONLEDGER_ALLOW_PRIVATE_IP_TARGETS_FOR_TESTING=true

# Release 1.1 credentials are added here as those collectors are built. Every entry
# will be a placeholder plus the provider's official key-setup URL - never a real or
# implied key. All release 1.1 sources must run in a "needs-key" state without any
# entry below.
